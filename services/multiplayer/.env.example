# Public DNS names. Point both records at the VM before starting Docker Compose.
SIGNALING_DOMAIN=signal.example.com
TURN_REALM=turn.example.com

# Your GitHub Pages URL, without a trailing slash. Add preview origins separated by commas if needed.
ALLOWED_ORIGINS=https://YOUR_ACCOUNT.github.io
MAX_PLAYERS=4

# Long, random values. For production, replace static TURN auth with TURN REST credentials.
TURN_USERNAME=graveyard-shift
TURN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_VALUE

# Absolute host path containing fullchain.pem and privkey.pem for turn.example.com.
TURN_CERT_DIRECTORY=/srv/graveyard-shift-turn-certs
